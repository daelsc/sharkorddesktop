<Window x:Class="Sharkov.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sharkov" Width="1280" Height="800"
        MinWidth="800" MinHeight="600"
        Background="#1a1a1a"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ServerBtn" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#e4e4e7"/>
            <Setter Property="Background" Value="#2a2a2e"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3f3f46"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="True">
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActiveServerBtn" TargetType="Button" BasedOn="{StaticResource ServerBtn}">
            <Setter Property="Background" Value="#3b82f6"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>     <!-- sidebar -->
            <ColumnDefinition Width="*"/>       <!-- content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0d0d0d" Padding="12,8,12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>          <!-- server buttons (scroll) -->
                    <RowDefinition Height="Auto"/>        <!-- footer actions -->
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="ServerButtons" Orientation="Vertical"/>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                    <Button x:Name="AddServerBtn" Content="+" Width="48" Height="48"
                            FontSize="22" Foreground="#e4e4e7" Background="#2a2a2e" BorderThickness="0"
                            Margin="0,8,0,0" Cursor="Hand" Click="AddServerBtn_Click" ToolTip="Add server"/>
                    <TextBlock x:Name="VersionLabel" Text="" Foreground="#52525b" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area: one WebView2 per saved server, stacked; visibility toggled -->
        <Grid Grid.Column="1" x:Name="ContentArea">
            <TextBlock x:Name="EmptyState" Text="There are no saved servers to connect to.&#x0a;Add one with the + button."
                       Foreground="#71717a" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Grid>

        <!-- Bitrate bar overlay (top-left of content area) -->
        <Border Grid.Column="1" x:Name="BitrateBar" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="10,6,0,0" Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                CornerRadius="6" Padding="8,3" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Bitrate" Foreground="#a1a1aa" FontSize="11" VerticalAlignment="Center"/>
                <ComboBox x:Name="BitrateCombo" Margin="6,0,0,0" FontSize="11" MinWidth="70"
                          Background="#27272a" Foreground="#e4e4e7" BorderBrush="#3f3f46"
                          SelectionChanged="BitrateCombo_SelectionChanged"/>
                <Button x:Name="PttBtn" Content="PTT" Margin="6,0,0,0" FontSize="11"
                        Padding="8,2" Background="#27272a" Foreground="#e4e4e7"
                        BorderBrush="#3f3f46" BorderThickness="1" Cursor="Hand"
                        ToolTip="Set the push-to-talk key" Click="PttBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
